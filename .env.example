# ==============================================================================
# Stock Tracker — Production Environment Variables Template (.env.example)
# Copy this file to .env on the production host and fill in strong, cryptographic values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Core ASP.NET Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000

# Security Keys (REQUIRED — Generate min 64 random characters)
# Example: openssl rand -base64 48
JWT_SECRET_KEY=YOUR_SUPER_SECURE_CRYPTOGRAPHIC_JWT_SECRET_KEY_MIN_32_BYTES_LONG_HERE
SECRET_PROTECTION_KEY=YOUR_SUPER_SECURE_CRYPTOGRAPHIC_DATA_PROTECTION_KEY_HERE

# JWT Tokens Configuration
JWT_ISSUER=StockTracker
JWT_AUDIENCE=StockTrackerUsers

# SQLite Database Connection String
ConnectionStrings__DefaultConnection=Data Source=/var/data/stocktracker.db;Cache=Shared

# Allowed CORS Origins (Replace with your production domain)
Cors__AllowedOrigins__0=https://tracker.yourdomain.com

# Stock Monitoring Worker Configuration
StockMonitoring__WorkerIntervalSeconds=30

# Playwright Browser Configuration
Browser__Headless=true
Browser__Channel=
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
